{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "安装基础和开发依赖",
      "type": "process",
      "command": "uv",
      "args": [
        "sync",
        "--extra",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "安装训练依赖",
      "type": "process",
      "command": "uv",
      "args": [
        "sync",
        "--extra",
        "train",
        "--extra",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "运行测试",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "pytest"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}

